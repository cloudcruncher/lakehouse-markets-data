# Card authorisations for markets.payments.card-auths, generated by ShadowTraffic (step 1.6).
# Published as ghcr.io/cloudcruncher/lakehouse-markets-data:card-auths-<version> and run by the
# platform as a tenant service. The licence is not in the image: the platform mounts it from the
# tenant's secrets folder (SHADOWTRAFFIC_ENV_FILE); without it the generator idles.
FROM shadowtraffic/shadowtraffic:2.2.1
COPY card-auths.json /home/card-auths.json
COPY run.sh /home/run.sh
USER nonroot
ENTRYPOINT ["/bin/sh", "/home/run.sh"]
